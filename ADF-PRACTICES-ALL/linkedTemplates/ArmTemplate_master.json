{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-PRACTICES-ALL"
		},
		"LS_SINK_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SINK'"
		},
		"SOURCE_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'SOURCE_LS'"
		},
		"LS_KV_SQL_DB_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://KV-Demo31aug.vault.azure.net/"
		},
		"LS_SINK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demostorageaccount3108.dfs.core.windows.net/"
		},
		"SOURCE_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demostorageaccount3108.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-PRACTICES-ALL_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SINK_accountKey": {
						"value": "[parameters('LS_SINK_accountKey')]"
					},
					"SOURCE_LS_accountKey": {
						"value": "[parameters('SOURCE_LS_accountKey')]"
					},
					"LS_KV_SQL_DB_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KV_SQL_DB_properties_typeProperties_baseUrl')]"
					},
					"LS_SINK_properties_typeProperties_url": {
						"value": "[parameters('LS_SINK_properties_typeProperties_url')]"
					},
					"SOURCE_LS_properties_typeProperties_url": {
						"value": "[parameters('SOURCE_LS_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}